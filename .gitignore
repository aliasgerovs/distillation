__pycache__/
.pytest_cache/
.venv/
dist/
build/
*.egg-info/

# Run outputs: commit each run's small files (results, configs, manifests, sample traces);
# the bulk trace JSONs (~100 MB per run) stay local.
outputs/**
!outputs/**/
!outputs/**/results.json
!outputs/**/RESULTS.md
!outputs/**/config_snapshot.yaml
!outputs/**/run_manifest.json
!outputs/**/*.md
!outputs/**/inspection/*.json
artifacts/

*.pyc
*.pyo
*.DS_Store
scripts/student_attr_ablation_local.py

# Replication: local-only files (paper PDF, queue runtime state, model-weight symlinks)
paper/
replication/state/
replication/models/**/*.safetensors
replication/models/**/model.safetensors.index.json
